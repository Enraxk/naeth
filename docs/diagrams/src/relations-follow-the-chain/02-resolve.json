[
  { "_doc": "Part 2: the three read-time resolution steps and the result." },

  { "type": "text", "id": "c_band2", "x": 140, "y": 560,
    "text": "HOW IT RESOLVES, ON READ", "fontSize": 16, "fontFamily": 3, "strokeColor": "#64748b" },

  { "type": "rectangle", "id": "c_s1", "x": 140, "y": 595, "width": 420, "height": 155,
    "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "strokeWidth": 2, "roughness": 0,
    "label": { "text": "1    _chain_ids(A.v3)\n\nwalks supersession in both\ndirections, ancestors and\ndescendants alike\n\nresult:  { v1, v2, v3 }",
               "fontSize": 13, "fontFamily": 3, "strokeColor": "#374151" } },

  { "type": "rectangle", "id": "c_s2", "x": 620, "y": 595, "width": 420, "height": 155,
    "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "strokeWidth": 2, "roughness": 0,
    "label": { "text": "2    match every relation whose\nsource or target is ANY id in\nthat chain\n\nfinds the May edge hanging off\nv1, skips tombstoned ones",
               "fontSize": 13, "fontFamily": 3, "strokeColor": "#374151" } },

  { "type": "rectangle", "id": "c_s3", "x": 1100, "y": 595, "width": 420, "height": 155,
    "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "strokeWidth": 2, "roughness": 0,
    "label": { "text": "3    _current_of() each endpoint\n\nfollows child links to the live\nleaf, then dedupes by\n(source, target, predicate)",
               "fontSize": 13, "fontFamily": 3, "strokeColor": "#374151" } },

  { "type": "arrow", "start": { "id": "c_s1" }, "end": { "id": "c_s2" }, "strokeColor": "#6d28d9" },
  { "type": "arrow", "start": { "id": "c_s2" }, "end": { "id": "c_s3" }, "strokeColor": "#6d28d9" },

  { "type": "rectangle", "id": "c_result", "x": 1100, "y": 845, "width": 420, "height": 100,
    "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "strokeWidth": 2, "roughness": 0,
    "label": { "text": "relation_list(A.v3) returns\n\nA.v3   depends_on   B.w2",
               "fontSize": 14, "fontFamily": 3, "strokeColor": "#374151" } },

  { "type": "arrow", "start": { "id": "c_s3" }, "end": { "id": "c_result" }, "strokeColor": "#047857" },

  { "type": "text", "id": "c_punch", "x": 140, "y": 855,
    "text": "The edge is never rewritten.\nBoth of its ends are resolved on read.",
    "fontSize": 22, "fontFamily": 3, "strokeColor": "#1e40af" }
]

 plus its\nfull supersession chain", "autoResize": true, "lineHeight": 1.2}, {"id": "fpA6NC9Lv17e9Axvq3EyF", "type": "text", "x": 1171.44287109375, "y": 254.8, "width": 197.1142578125, "height": 50.400000000000006, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "aK", "roundness": null, "seed": 49172529, "version": 3, "versionNonce": 1300936561, "isDeleted": false, "boundElements": null, "updated": 1785874538177, "link": null, "locked": false, "text": "memory_search(query, k)\nhybrid RRF, HNSW + tsvector\nthe agent's recall path", "fontSize": 14, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "a_search", "originalText": "memory_search(query, k)\nhybrid RRF, HNSW + tsvector\nthe agent's recall path", "autoResize": true, "lineHeight": 1.2}, {"id": "fflMkF36hSx9-e1GGPvTT", "type": "text", "x": 1188.53515625, "y": 440.4, "width": 162.9296875, "height": 19.2, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "aL", "roundness": null, "seed": 1173824017, "version": 3, "versionNonce": 791901215, "isDeleted": false, "boundElements": null, "updated": 1785874538177, "link": null, "locked": false, "text": "VIEW memory_current", "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "a_view", "originalText": "VIEW memory_current", "autoResize": true, "lineHeight": 1.2}, {"id": "rNyODNEHEtvKduR6_DxZ1", "type": "text", "x": 135, "y": 982.9, "width": 340.3740234375, "height": 109.2, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "aM", "roundness": null, "seed": 936032241, "version": 3, "versionNonce": 654614865, "isDeleted": false, "boundElements": null, "updated": 1785874538177, "link": null, "locked": false, "text": "CREATE VIEW memory_current AS\nSELECT m.* FROM memory m\nWHERE NOT EXISTS (SELECT 1 FROM tombstone t\n                  WHERE t.target_id = m.id\n                    AND t.target_kind = 'memory')\n  AND NOT EXISTS (SELECT 1 FROM supersession s\n                  WHERE s.parent_id = m.id);", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "containerId": "a_ev1", "originalText": "CREATE VIEW memory_current AS\nSELECT m.* FROM memory m\nWHERE NOT EXISTS (SELECT 1 FROM tombstone t\n                  WHERE t.target_id = m.id\n                    AND t.target_kind = 'memory')\n  AND NOT EXISTS (SELECT 1 FROM supersession s\n                  WHERE s.parent_id = m.id);", "autoResize": true, "lineHeight": 1.2}, {"id": "HbhhTJ6OTX4gKAmjmKxZf", "type": "text", "x": 835, "y": 982.9, "width": 344.119140625, "height": 109.2, "angle": 0, "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "aN", "roundness": null, "seed": 980455889, "version": 3, "versionNonce": 839751743, "isDeleted": false, "boundElements": null, "updated": 1785874538177, "link": null, "locked": false, "text": "add()        INSERT row  +  queue embed job\nsupersede()  INSERT new row  +  INSERT supersession\ntombstone()  INSERT tombstone row\n\nNo UPDATE. No DELETE.\n(only exceptions: the async embedding fill\n and the is_current cache column)", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle", "containerId": "a_ev2", "originalText": "add()        INSERT row  +  queue embed job\nsupersede()  INSERT new row  +  INSERT supersession\ntombstone()  INSERT tombstone row\n\nNo UPDATE. No DELETE.\n(only exceptions: the async
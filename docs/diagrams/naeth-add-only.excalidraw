{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"id": "a_title", "type": "text", "x": 60, "y": 40, "width": 617.9443359375, "height": 36, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a0", "roundness": null, "seed": 568636081, "version": 2, "versionNonce": 1106391473, "isDeleted": false, "boundElements": null, "updated": 1785874538104, "link": null, "locked": false, "text": "In Naeth, a memory is a chain, not a row", "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "In Naeth, a memory is a chain, not a row", "autoResize": true, "lineHeight": 1.2}, {"id": "a_sub", "type": "text", "x": 60, "y": 92, "width": 874.09716796875, "height": 20.4, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "a1", "roundness": null, "seed": 1643760863, "version": 2, "versionNonce": 851951071, "isDeleted": false, "boundElements": null, "updated": 1785874538104, "link": null, "locked": false, "text": "Nothing is overwritten and nothing is deleted. Replacing a fact inserts a new row and keeps the old one.", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Nothing is overwritten and nothing is deleted. Replacing a fact inserts a new row and keeps the old one.", "autoResize": true, "lineHeight": 1.2}, {"id": "a_frame_label", "type": "text", "x": 700, "y": 570, "width": 338.95751953125, "height": 18, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index":
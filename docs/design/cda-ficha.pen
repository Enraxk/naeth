          "fill": "$dim",
          "content": "C · CUATRO FORMAS DE DECIR POR DÓNDE VAS, SIN LA CINTA",
          "fontFamily": "$font-sans",
          "fontSize": 11,
          "fontWeight": "normal",
          "letterSpacing": 1.2
        },

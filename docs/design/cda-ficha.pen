          "x": 520,
          "y": 530,
          "name": "llamada",
          "fill": "$dim",
          "textGrowth": "fixed-width",
          "width": 700,
          "content": "Qué cambia entre ellas en la pila: B1 y B2 dejan que los libros se toquen; B3 pone aire entre libros que en una pila real no hay, así que en la pila valdría B2 y B3 solo para el libro que se levanta al pasar el ratón.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 11,
          "fontWeight": "normal"
        }

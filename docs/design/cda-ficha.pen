                    },
                    {
                      "type": "frame",
                      "id": "sYZJK",
                      "name": "cuerpo doc",
                      "width": "fill_container",
                      "stroke": "#2a2d31",
                      "strokeWidth": {
                        "left": 1
                      },
                      "layout": "vertical",
                      "gap": 14,
                      "padding": [
                        0,
                        0,
                        0,
                        14
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "Lk66X",
                          "name": "resumen",
                          "fill": "#e6e8eb",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "La tool de entrada: core.search con la consulta embebida, y cada hit recortado a su digest.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-sans",
                          "fontSize": 14.5,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "xPG8l",
                          "name": "contexto",
                          "fill": "#b7bec8",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "La description del decorador es lo que lee el agente y se mantiene ahí; esto es para quien mantiene la tool. Embebe la consulta con _embed_query, pasa los cuatro filtros a core.search, y reduce cada fila con _hit, que quita content y deja digest más digest_source.",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-sans",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "vprzG",
                          "name": "h PARÁMETROS",
                          "fill": "#8a929e",
                          "content": "PARÁMETROS",
                          "fontFamily": "$font-sans",
                          "fontSize": 11,
                          "fontWeight": "600",
                          "letterSpacing": 1
                        },
                        {
                          "type": "frame",
                          "id": "PW5Ew",
                          "name": "params",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 5,

                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "¿Por qué memory_search devuelve el digest y no el texto?",
                  "lineHeight": 1.25,
                  "fontFamily": "$font-sans",
                  "fontSize": 28,
                  "fontWeight": "600",
                  "letterSpacing": -0.3

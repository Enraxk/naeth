        {
          "type": "text",
          "id": "VR4du",
          "x": 64,
          "y": 1010,
          "name": "llamada",
          "fill": "$dim",
          "textGrowth": "fixed-width",
          "width": 1216,
          "content": "Naeth, un cielo de estrellas (la memoria como constelaciones, el grafo); CENIT, una cumbre (cenit); GridWatch, líneas de alta tensión; Yogin, una sala de yoga. Fotos de stock de Pencil como aproximación; para el visor, una imagen por proyecto elegida por ti, teñida con el color del proyecto para que sigan siendo una colección.",
          "lineHeight": 1.45,
          "fontFamily": "$font-sans",
          "fontSize": 11,
          "fontWeight": "normal"
        }
      ]
    },

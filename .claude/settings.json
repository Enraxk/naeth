{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\py-lint.ps1\"",
            "timeout": 30,
            "statusMessage": "Verificando Python con ruff"
          }
        ]
      }
    ]
  }
}
